<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit config for the `freshwpl-risky` worktree.

    Identical to phpunit.xml except TEST_BASE_URL points at :8001 — this
    worktree's own instance, backed by the `localdesk_risky` database.

    Why this file exists: the committed phpunit.xml pins TEST_BASE_URL to
    :8000, which in this developer's setup is the *production* tree. Feature
    tests create real tickets and log in as fixture users, so running the
    suite with that default would write into the production database. The
    value is set force="true" here so it cannot be silently inherited.

    Usage:  vendor/bin/phpunit -c phpunit.risky.xml
    Serve:  php -S 127.0.0.1:8001 -t public public/index.php
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="false"
         stopOnFailure="false">

    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <php>
        <env name="TEST_BASE_URL" value="http://127.0.0.1:8001" force="true"/>
    </php>

</phpunit>
